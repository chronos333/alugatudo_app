# ============================================================
# ALUGA TUDO — AMBIENTE E CONFIGURAÇÃO LOCAL (.env.example)
# ============================================================

# API & Gateway Configuration
API_URL=http://localhost:8080/api/v1
API_TIMEOUT_MS=15000

# Autenticação e Segurança
JWT_SECRET=your_super_secret_jwt_key_here
TOKEN_EXPIRATION_HOURS=72

# Provedor de Pagamentos & Escrow (Custódia Garantida de Caução)
PAYMENT_GATEWAY_API_KEY=pk_test_alugatudo_escrow_sandbox_key
PAYMENT_GATEWAY_WEBHOOK_SECRET=whsec_alugatudo_test_secret

# Provedor KYC (Validação Documental de Usuários)
KYC_PROVIDER_ENDPOINT=https://api.kyc-verification.local/v1
KYC_PROVIDER_CLIENT_ID=client_alugatudo_kyc_id
KYC_PROVIDER_CLIENT_SECRET=client_alugatudo_kyc_secret

# Armazenamento e Mídia (Fotos de Vistoria e Itens)
STORAGE_BUCKET_NAME=alugatudo-inspection-photos
STORAGE_REGION=sa-east-1
